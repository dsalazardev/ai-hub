flowchart LR
  subgraph RISK["Categorias de riesgo"]
    R0["R0 Docs"]
    R1["R1 UI"]
    R2["R2 Logica de negocio"]
    R3["R3 Datos, seguridad e infraestructura"]
    R4["R4 Produccion o irreversible"]
  end
  subgraph AUTO["Niveles de autonomia"]
    A0["A0 Manual"]
    A1["A1 Sugerir"]
    A2["A2 Spec"]
    A3["A3 Implementar y abrir MR"]
    A4["A4 Revisar y validar"]
    A5["A5 Autonomo"]
  end
  R0 -->|hasta| A5
  R1 -->|hasta| A4
  R2 -->|hasta| A3
  R3 -->|hasta| A2
  R4 -->|hasta| A1
  A0 --> HUMAN["Humano decide todo"]
  A1 --> HUMAN
  A2 --> SPECAPP["Aprobacion humana de spec"]
  A3 --> MERGEAPP["Aprobacion humana de merge"]
  A4 --> MERGEAPP
  A5 --> AUDIT["Auditoria posterior"]
  R4 -.->|nunca auto-merge| MERGEAPP
  %% La tabla riesgo-autonomia es una propuesta de politica.
  %% Los permisos por accion siguen pendientes de definicion.
  classDef risk fill:#fee2e2,stroke:#dc2626,color:#000
  classDef auto fill:#dbeafe,stroke:#2563eb,color:#000
  classDef human fill:#fff7d6,stroke:#b58900,color:#000
  classDef gate fill:#fef3c7,stroke:#d97706,color:#000
  class R0,R1,R2,R3,R4 risk
  class A0,A1,A2,A3,A4,A5 auto
  class HUMAN,SPECAPP,MERGEAPP,AUDIT human
