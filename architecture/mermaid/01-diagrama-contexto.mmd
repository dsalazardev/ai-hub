flowchart LR
  subgraph HUMANS["Actores humanos"]
    PROD["Producto / CTO"]
    LEAD["Tech Lead"]
    QA["QA / Usuario"]
  end
  subgraph SYSTEM["AI Hub 3.0"]
    HERMES["Hermes control plane"]
    RUNNER["Runner + Claude Code"]
    KNOW["Spec Kit + AI Hub"]
  end
