  NOTIF -->|aprobaciones| LEAD
  classDef human fill:#fff7d6,stroke:#b58900,color:#000
  classDef system fill:#dbeafe,stroke:#2563eb,color:#000
  classDef exec fill:#dcfce7,stroke:#16a34a,color:#000
  classDef external fill:#ffedd5,stroke:#ea580c,color:#000
