    GL["GitLab self-managed"]
    CI["GitLab CI"]
    MODEL["Proveedor de modelos"]
    APP["Proyecto target"]
    PREV["Preview environments"]
    NOTIF["Canal de notificaciones"]
  end
  PROD -->|define y aprueba| GL
  LEAD -->|revisa y aprueba| GL
  QA -->|valida| PREV
  GL -->|webhooks y API| HERMES
