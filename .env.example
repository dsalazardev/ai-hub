# AI Hub — credenciales para agentes (copia este archivo a .ai-hub/.env)
# .ai-hub/.env NUNCA se versiona (patrón *.env del .gitignore).

# GitLab self-managed (API REST v4). Crear el PAT con scope "api" en:
# https://gitlab.v3.onnadigital.com/-/user_settings/personal_access_tokens
GITLAB_URL=https://gitlab.v3.onnadigital.com
GITLAB_TOKEN=glpat-CHANGEME

# Fallback opcional SOLO para flujos UI-only con Playwright (no recomendado)
GITLAB_USER=CHANGEME
GITLAB_PASSWORD=CHANGEME
