{
  "name": "@dsalazardev/ai-hub-cli",
  "version": "0.4.0",
  "author": "Daner Alejandro Salazar Colorado",
  "license": "MIT",
  "type": "module",
  "description": "AI Hub CLI — arnés agéntico instalable: bootstrap de .ai-hub/, preset por detección, sync multi-target, doctor y guardias.",
  "keywords": [
    "ai",
    "agents",
    "harness",
    "software-factory",
    "spec-kit",
    "cli",
    "scaffolding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsalazardev/ai-hub.git"
  },
  "homepage": "https://github.com/dsalazardev/ai-hub#readme",
  "bugs": {
    "url": "https://github.com/dsalazardev/ai-hub/issues"
  },
  "bin": {
    "ai-hub": "dist/bin/ai-hub.js"
  },
  "files": [
    "dist",
    "schema",
    "manifest.json",
    "engine",
    "presets",
    "rules",
    "agents",
    "skills",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "manifest:build": "node dist/manifest/cli.js",
    "manifest:check": "node dist/manifest/cli.js --check",
    "prepublishOnly": "npm run build && npm run manifest:build && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
