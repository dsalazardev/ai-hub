{
  "name": "@onna/ai-hub-cli",
  "version": "1.0.0",
  "author": "Daner Alejandro Salazar Colorado",
  "type": "module",
  "description": "AI Hub CLI — harness bootstrap, sync, diagnostics and guardrails for the Autonomous Software Factory.",
  "bin": {
    "ai-hub": "dist/bin/ai-hub.js"
  },
  "files": [
