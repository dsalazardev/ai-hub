{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiHubPresetV1",
  "type": "object",
  "required": ["id", "version", "description"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "extends": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 10 },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "packageManager": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "string" },
        "build": { "type": "string" },
        "test": { "type": "string" },
        "typecheck": { "type": "string" },
        "lint": { "type": "string" },
        "verify": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trunk": { "enum": ["auto", "closed", "open"] },
        "guardMode": { "enum": ["shadow", "enforce"] },
        "worktrees": { "type": "boolean" },
        "optOuts": { "type": "array", "items": { "type": "string" } },
        "dangerPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pattern", "decision", "reason"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9:-]*$" },
              "pattern": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["ask", "deny"] },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "rules": { "type": "array", "items": { "type": "string" } },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publish": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publish": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" }
      }
    }
  }
}
