{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiHubProjectManifestV2",
  "type": "object",
  "required": [
    "version",
    "project",
    "preset",
    "stack",
    "commands",
    "paths",
    "targets",
    "policy",
    "skills",
    "agents",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "version", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "source": { "enum": ["package"] }
      }
    },
    "stack": {
      "type": "object",
      "required": ["languages"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "packageManager": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "string" },
        "build": { "type": "string" },
        "test": { "type": "string" },
        "typecheck": { "type": "string" },
        "lint": { "type": "string" },
        "verify": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "required": ["source", "tests", "docs"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "paths", "role"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "role": { "type": "string" },
              "rules": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy": {
      "type": "object",
      "required": ["trunk", "guardMode", "worktrees", "optOuts"],
      "additionalProperties": false,
      "properties": {
        "trunk": { "enum": ["auto", "closed", "open"] },
        "guardMode": { "enum": ["shadow", "enforce"] },
        "worktrees": { "type": "boolean" },
        "optOuts": { "type": "array", "items": { "type": "string" } },
        "maxRounds": { "type": "integer", "minimum": 1 },
        "wip": { "type": "integer", "minimum": 1 },
        "requireEars": { "type": "boolean" },
        "requireTraceability": { "type": "boolean" },
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "keep": { "type": "integer", "minimum": 1, "maximum": 500 } }
        },
        "legacy": {
          "type": "object",
          "required": ["openspec", "until"],
          "additionalProperties": false,
          "properties": {
            "openspec": { "const": "archive" },
            "until": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        },
        "dangerPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pattern", "decision", "reason"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9:-]*$" },
              "pattern": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["ask", "deny"] },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["source", "publish"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "selection": { "enum": ["full", "preset", "custom"] },
        "publish": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "agents": {
      "type": "object",
      "required": ["source", "publish"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "selection": { "enum": ["full", "preset", "custom"] },
        "publish": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "rules": {
      "type": "object",
      "required": ["source", "publish"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "selection": { "enum": ["full", "preset", "custom"] },
        "publish": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "catalog": {
      "type": "object",
      "required": ["version", "hash"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "agentsMd": { "type": "boolean" },
    "agentMemory": { "enum": ["versioned", "ignored"] },
    "agentModels": {
      "type": "object",
      "propertyNames": { "enum": ["claude", "opencode", "pi", "cursor", "copilot"] },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "enum": ["light", "balanced", "heavy"] },
        "additionalProperties": { "type": "string", "minLength": 1 }
      }
    },
    "tracker": {
      "type": "object",
      "required": ["kind", "urlEnv", "tokenEnv"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["gitlab"] },
        "urlEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "tokenEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvers": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5,25}$" }, "uniqueItems": true },
        "channelId": { "type": "string", "pattern": "^[0-9]{17,20}$" },
        "ttlHours": { "type": "number", "exclusiveMinimum": 0, "maximum": 720 },
        "expire": { "enum": ["block", "notify"] },
        "pollMinutes": { "type": "integer", "minimum": 5, "maximum": 1440 }
      }
    },
    "speckit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managed": { "type": "boolean" },
        "version": { "type": "string", "minLength": 1 },
        "script": { "enum": ["sh", "ps", "py"] },
        "scripts": {
          "type": "array",
          "items": { "enum": ["sh", "ps", "py"] },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "defaultTarget": { "type": "string", "minLength": 1 }
      }
    }
  }
}
