# Credenciales locales del arnés AI-Hub (ejemplo versionado).
# Copia este archivo a .ai-hub/.env y rellena los valores en tu máquina.
# .ai-hub/.env está ignorado por git desde `ai-hub init`; nunca lo versiones.
# AI-Hub jamás escribe este archivo por su cuenta: solo tú, a mano o con el
# paso opcional del asistente interactivo de `ai-hub init`.
GITLAB_URL=CHANGEME
GITLAB_TOKEN=CHANGEME
